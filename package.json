{
  "name": "angelopana-portfolio",
  "description": "Angelo Pana's portfolio, built with Hugo and the Hugoplate theme",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"node scripts/themeGenerator.js --watch\" \"hugo server -O\"",
    "build": "node scripts/themeGenerator.js && hugo --gc --minify --cleanDestinationDir",
    "preview": "node scripts/themeGenerator.js && hugo server --disableFastRender --navigateToChanged --watch -e production --minify -O",
    "update-modules": "node ./scripts/clearModules.js && hugo mod clean --all && hugo mod get -u ./... && hugo mod tidy",
    "update-theme": "node ./scripts/themeUpdate.js",
    "remove-darkmode": "node ./scripts/removeDarkmode.js && npm run format",
    "remove-multilang": "node ./scripts/removeMultilang.js",
    "format": "prettier -w .",
    "postinstall": "node -e \"const fs=require('fs'),p='node_modules/.bin/tailwindcss';try{fs.lstatSync(p).isSymbolicLink()||((fs.unlinkSync(p)),fs.symlinkSync('../@tailwindcss/cli/dist/index.mjs',p))}catch(e){}\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.3",
    "prettier-plugin-go-template": "0.0.15",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "^4.3.0"
  }
}
